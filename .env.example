# Supabase Configuration
# Copy this file to .env and fill in your actual values

VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# IMPORTANT: NEVER commit the service_role key to version control
# The service_role key must NEVER be used in the frontend
# All client operations use the anon key with Row Level Security (RLS)

# Google Gemini AI Configuration (master multi-image stylist)
# Get a key at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional fallback for vision/reasoning when Gemini is unavailable
# Get a key at https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# Set true after deploying supabase/functions/stylist.
# The Edge Function keeps GEMINI_API_KEY off the browser.
VITE_USE_SECURE_STYLIST=false
